{
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "^2.2.2",
    "@ryu/app-host": "workspace:*",
    "@ryu/blocks": "workspace:*",
    "@ryu/ui": "workspace:*",
    "@toolwind/corner-shape": "0.0.8-3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "catalog:"
