    "@ryu/app-host": "workspace:*",
    "@ryu/blocks": "workspace:*",
    "@ryu/ui": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@ryu/config": "workspace:*",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4",
