  "name": "@ryu/whiteboard-app",
  "private": true,
  "ryuCompanionInteractionMap": "e2e/companion-interactions.json",
  "scripts": {
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "test": "bun test src && bun test e2e/interaction-map.test.mjs",
    "test:e2e": "node ../../../apps/desktop/node_modules/@playwright/test/cli.js test --config=e2e/whiteboard-companion.playwright.config.ts"
